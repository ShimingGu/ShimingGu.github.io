---
---

<div class="hero-web hero-web-shell" data-cosmic-web>
  <svg class="hero-web-fallback" viewBox="0 0 320 320" aria-hidden="true">
    <g fill="none" stroke="#1d1d1f" stroke-width="0.9" opacity="0.2">
      <path d="M62 93 Q105 62 145 105 T226 89 M62 93 Q88 145 69 193 T128 245 M145 105 Q158 151 128 245 M226 89 Q246 137 218 178 T128 245 M69 193 Q142 176 218 178" />
      <path d="M41 118 Q62 93 92 83 M92 83 Q123 75 145 105 M145 105 Q183 82 207 111 M207 111 Q238 120 251 150 M218 178 Q228 207 199 230 M199 230 Q160 256 128 245 M128 245 Q86 241 69 215" />
    </g>
    <g fill="#1d1d1f" opacity="0.72">
      <circle cx="62" cy="93" r="3.2" /><circle cx="41" cy="118" r="1.7" />
      <circle cx="92" cy="83" r="2.1" /><circle cx="145" cy="105" r="3.5" />
      <circle cx="207" cy="111" r="2.2" /><circle cx="226" cy="89" r="3.1" />
      <circle cx="251" cy="150" r="1.8" /><circle cx="218" cy="178" r="3.4" />
      <circle cx="199" cy="230" r="2.2" /><circle cx="128" cy="245" r="3.3" />
      <circle cx="69" cy="215" r="1.8" /><circle cx="69" cy="193" r="2.8" />
      <circle cx="105" cy="143" r="1.5" /><circle cx="169" cy="167" r="2.2" />
      <circle cx="151" cy="211" r="1.4" /><circle cx="237" cy="53" r="1.3" />
    </g>
  </svg>
  <canvas
    id="cosmic-web"
    class="hero-web-canvas"
    role="img"
    aria-label="具有周期边界和动态最近邻连线的三维宇宙网，可拖拽旋转"
    title="拖拽旋转宇宙网"
  ></canvas>
</div>

<script>
  import * as THREE from 'three';

  const shell = document.querySelector<HTMLElement>('[data-cosmic-web]');
  const canvas = document.getElementById('cosmic-web') as HTMLCanvasElement | null;

  if (shell && canvas) {
    try {
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let reduced = reducedMotion.matches;
      const abort = new AbortController();
      const { signal } = abort;

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'low-power',
      });
      renderer.setClearColor(0x000000, 0);
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 50);
      camera.position.set(0, 0, 7.2);

      const web = new THREE.Group();
      web.rotation.order = 'YXZ';
      scene.add(web);

      scene.add(new THREE.AmbientLight(0xffffff, 1.25));
      const keyLight = new THREE.DirectionalLight(0xffffff, 2.1);
      keyLight.position.set(3, 4, 6);
      scene.add(keyLight);

      let seed = 0x6d2b79f5;
      const random = () => {
        seed |= 0;
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
      const randomVector = (amplitude: number) =>
        new THREE.Vector3(
          (random() - 0.5) * amplitude,
          (random() - 0.5) * amplitude,
          (random() - 0.5) * amplitude,
        );

      // A cubic periodic volume with anisotropic display dimensions. Positions wrap;
      // neighbour distances always use the shortest periodic image.
      const BOX = new THREE.Vector3(4.4, 4.0, 3.2);
      const LINK_DISTANCE = 0.92;
      const LINK_INTERVAL = 0.8;
      const CURVE_SEGMENTS = 10;
      const wrap = (value: number, size: number) =>
        THREE.MathUtils.euclideanModulo(value + size / 2, size) - size / 2;
      const periodicDelta = (a: THREE.Vector3, b: THREE.Vector3, target: THREE.Vector3) => {
        target.copy(b).sub(a);
        target.x -= Math.round(target.x / BOX.x) * BOX.x;
        target.y -= Math.round(target.y / BOX.y) * BOX.y;
        target.z -= Math.round(target.z / BOX.z) * BOX.z;
        return target;
      };

      interface WebNode {
        position: THREE.Vector3;
        velocity: THREE.Vector3;
        radius: number;
        degree: number;
      }
      interface WebEdge {
        a: number;
        b: number;
        key: string;
        bend: THREE.Vector3;
        length: number;
      }

      const nodes: WebNode[] = [];
      const edges: WebEdge[] = [];
      const bendCache = new Map<string, THREE.Vector3>();

      // Anisotropic halos and uneven curved filaments surround a central void.
      // This is an LSS-inspired initial configuration, not a cosmological simulation.
      const halos = [
        { position: new THREE.Vector3(-1.28, 0.72, -0.28), count: 11, radius: 0.074, extent: 0.54 },
        { position: new THREE.Vector3(-0.52, 1.28, 0.12), count: 6, radius: 0.045, extent: 0.34 },
        { position: new THREE.Vector3(0.52, 0.93, -0.48), count: 4, radius: 0.037, extent: 0.27 },
        { position: new THREE.Vector3(1.30, 0.18, 0.28), count: 10, radius: 0.065, extent: 0.47 },
        { position: new THREE.Vector3(0.78, -1.06, -0.24), count: 7, radius: 0.052, extent: 0.38 },
        { position: new THREE.Vector3(-0.38, -1.25, 0.28), count: 4, radius: 0.035, extent: 0.26 },
        { position: new THREE.Vector3(-1.38, -0.48, 0.42), count: 7, radius: 0.050, extent: 0.37 },
        { position: new THREE.Vector3(1.55, 1.05, -0.55), count: 3, radius: 0.032, extent: 0.22 },
        { position: new THREE.Vector3(-0.95, 1.50, 0.55), count: 3, radius: 0.034, extent: 0.23 },
      ];
      const clusterVelocities = halos.map(() =>
        randomVector(2).normalize().multiplyScalar(0.005 + random() * 0.003),
      );

      const addNode = (position: THREE.Vector3, radius: number, velocity: THREE.Vector3) => {
        nodes.push({ position, velocity, radius, degree: 0 });
        return nodes.length - 1;
      };
      const localVelocity = (flow: THREE.Vector3, spread = 0.004) =>
        flow.clone().add(randomVector(spread));

      halos.forEach((halo, cluster) => {
        const flow = clusterVelocities[cluster];
        addNode(halo.position.clone(), halo.radius, flow.clone());
        for (let i = 0; i < halo.count; i++) {
          const distance = 0.07 + Math.pow(random(), 1.35) * halo.extent;
          const offset = randomVector(2).normalize().multiplyScalar(distance);
          offset.x *= 1.2;
          offset.y *= 0.72;
          offset.z *= 0.85;
          const position = halo.position.clone().add(offset);
          const subhalo = i === 0 && halo.count >= 6 ? 0.012 : 0;
          addNode(position, 0.014 + random() * 0.024 + subhalo, localVelocity(flow));
        }
      });

      const filamentSpines = [
        { from: 0, to: 1, count: 5, bend: new THREE.Vector3(-0.10, 0.18, 0.20) },
        { from: 1, to: 2, count: 5, bend: new THREE.Vector3(0.00, 0.16, -0.18) },
        { from: 2, to: 3, count: 6, bend: new THREE.Vector3(0.18, 0.08, 0.22) },
        { from: 3, to: 4, count: 5, bend: new THREE.Vector3(0.22, -0.05, -0.18) },
        { from: 4, to: 5, count: 5, bend: new THREE.Vector3(0.05, -0.16, 0.20) },
        { from: 5, to: 6, count: 4, bend: new THREE.Vector3(-0.12, -0.08, -0.16) },
        { from: 6, to: 0, count: 5, bend: new THREE.Vector3(-0.20, 0.04, 0.20) },
        { from: 2, to: 7, count: 4, bend: new THREE.Vector3(0.10, 0.10, 0.10) },
        { from: 7, to: 3, count: 4, bend: new THREE.Vector3(0.15, -0.10, -0.10) },
        { from: 1, to: 8, count: 3, bend: new THREE.Vector3(-0.12, 0.02, 0.12) },
        { from: 8, to: 0, count: 3, bend: new THREE.Vector3(-0.16, 0.06, -0.08) },
      ];
      filamentSpines.forEach(({ from, to, count, bend }) => {
        const start = halos[from].position;
        const end = halos[to].position;
        const control = start.clone().lerp(end, 0.5).add(bend);
        const flow = clusterVelocities[from].clone().lerp(clusterVelocities[to], 0.5);
        for (let step = 0; step < count; step++) {
          const t = (step + 0.2 + random() * 0.6) / count;
          const u = 1 - t;
          const position = start.clone().multiplyScalar(u * u);
          position.addScaledVector(control, 2 * u * t);
          position.addScaledVector(end, t * t);
          position.add(randomVector(0.08 + random() * 0.12));
          const clump = step % 4 === 0 ? 0.009 : 0;
          addNode(position, 0.014 + random() * 0.021 + clump, localVelocity(flow, 0.003));
        }
      });

      for (let i = 0; i < 6; i++) {
        let position: THREE.Vector3;
        do {
          position = new THREE.Vector3(
            (random() - 0.5) * 3.8,
            (random() - 0.5) * 3.5,
            (random() - 0.5) * 2.2,
          );
        } while (position.length() < 0.9);
        addNode(
          position,
          0.013 + random() * 0.014,
          randomVector(2).normalize().multiplyScalar(0.004 + random() * 0.003),
        );
      }

      const delta = new THREE.Vector3();
      const neighborCount = (index: number) =>
        index < halos.length ? 4 : index % 4 === 0 ? 3 : 2;
      const rebuildEdges = () => {
        edges.length = 0;
        nodes.forEach((node) => { node.degree = 0; });
        const edgeKeys = new Set<string>();

        nodes.forEach((node, i) => {
          const nearest = nodes
            .map((other, j) => ({
              j,
              distance: periodicDelta(node.position, other.position, delta).lengthSq(),
            }))
            .filter((item) => item.j !== i && item.distance < LINK_DISTANCE * LINK_DISTANCE)
            .sort((a, b) => a.distance - b.distance)
            .slice(0, neighborCount(i));

          nearest.forEach(({ j, distance }) => {
            const key = i < j ? `${i}:${j}` : `${j}:${i}`;
            if (edgeKeys.has(key)) return;
            edgeKeys.add(key);
            periodicDelta(node.position, nodes[j].position, delta);
            let bend = bendCache.get(key);
            if (!bend) {
              const axis = randomVector(2).cross(delta);
              if (axis.lengthSq() < 1e-8) axis.set(0, 1, 0);
              else axis.normalize();
              bend = axis.multiplyScalar(Math.sqrt(distance) * (random() - 0.5) * 0.2);
              bend.z += (random() - 0.5) * Math.sqrt(distance) * 0.06;
              bendCache.set(key, bend);
            }
            edges.push({ a: i, b: j, key, bend, length: Math.sqrt(distance) });
            node.degree++;
            nodes[j].degree++;
          });
        });
      };
      rebuildEdges();

      const edgeDelta = new THREE.Vector3();
      const edgeStart = new THREE.Vector3();
      const edgeEnd = new THREE.Vector3();
      const edgeControl = new THREE.Vector3();
      const sampleCurve = (edge: WebEdge, t: number, target: THREE.Vector3, mirror = false) => {
        const a = nodes[edge.a].position;
        const b = nodes[edge.b].position;
        periodicDelta(a, b, edgeDelta);
        if (mirror) {
          edgeEnd.copy(b);
          edgeStart.copy(b).sub(edgeDelta);
        } else {
          edgeStart.copy(a);
          edgeEnd.copy(a).add(edgeDelta);
        }
        edgeControl.copy(edgeStart).addScaledVector(edgeDelta, 0.5).add(edge.bend);
        const u = 1 - t;
        target.set(0, 0, 0);
        target.addScaledVector(edgeStart, u * u);
        target.addScaledVector(edgeControl, 2 * u * t);
        target.addScaledVector(edgeEnd, t * t);
        return target;
      };

      const maxEdges = Math.ceil(
        nodes.reduce((sum, _, index) => sum + neighborCount(index), 0) / 2,
      );
      const maxLineVertices = maxEdges * 2 * CURVE_SEGMENTS * 2;
      const linePositions = new Float32Array(maxLineVertices * 3);
      const lineColors = new Float32Array(maxLineVertices * 3);
      const lineGeometry = new THREE.BufferGeometry();
      const linePositionAttribute = new THREE.BufferAttribute(linePositions, 3);
      const lineColorAttribute = new THREE.BufferAttribute(lineColors, 3);
      linePositionAttribute.setUsage(THREE.DynamicDrawUsage);
      lineColorAttribute.setUsage(THREE.DynamicDrawUsage);
      lineGeometry.setAttribute('position', linePositionAttribute);
      lineGeometry.setAttribute('color', lineColorAttribute);
      const lineMaterial = new THREE.LineBasicMaterial({
        vertexColors: true,
        transparent: true,
        opacity: 0.25,
        depthWrite: false,
      });
      const filaments = new THREE.LineSegments(lineGeometry, lineMaterial);
      filaments.frustumCulled = false;
      web.add(filaments);

      const ink = new THREE.Color('#1d1d1f');
      const muted = new THREE.Color('#86868b');
      const pointA = new THREE.Vector3();
      const pointB = new THREE.Vector3();
      const edgeColor = new THREE.Color();
      const updateFilaments = () => {
        let vertex = 0;
        edges.forEach((edge) => {
          periodicDelta(nodes[edge.a].position, nodes[edge.b].position, delta);
          const wrapped =
            Math.abs(nodes[edge.b].position.x - nodes[edge.a].position.x - delta.x) > 0.001 ||
            Math.abs(nodes[edge.b].position.y - nodes[edge.a].position.y - delta.y) > 0.001 ||
            Math.abs(nodes[edge.b].position.z - nodes[edge.a].position.z - delta.z) > 0.001;
          edgeColor.copy(ink).lerp(muted, Math.min(0.45, edge.length * 0.16));
          for (let copy = 0; copy < (wrapped ? 2 : 1); copy++) {
            for (let step = 0; step < CURVE_SEGMENTS; step++) {
              sampleCurve(edge, step / CURVE_SEGMENTS, pointA, copy === 1);
              sampleCurve(edge, (step + 1) / CURVE_SEGMENTS, pointB, copy === 1);
              for (const point of [pointA, pointB]) {
                const offset = vertex * 3;
                linePositions[offset] = point.x;
                linePositions[offset + 1] = point.y;
                linePositions[offset + 2] = point.z;
                lineColors[offset] = edgeColor.r;
                lineColors[offset + 1] = edgeColor.g;
                lineColors[offset + 2] = edgeColor.b;
                vertex++;
              }
            }
          }
        });
        lineGeometry.setDrawRange(0, vertex);
        linePositionAttribute.needsUpdate = true;
        lineColorAttribute.needsUpdate = true;
      };

      const nodeGeometry = new THREE.SphereGeometry(1, 12, 8);
      const nodeMaterial = new THREE.MeshStandardMaterial({
        color: '#242426',
        roughness: 0.48,
        metalness: 0.05,
      });
      const nodeMesh = new THREE.InstancedMesh(nodeGeometry, nodeMaterial, nodes.length);
      nodeMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
      nodeMesh.frustumCulled = false;
      const matrix = new THREE.Matrix4();
      const quaternion = new THREE.Quaternion();
      const scale = new THREE.Vector3();
      const updateNodes = (dt: number) => {
        nodes.forEach((node, i) => {
          if (dt > 0) {
            node.position.addScaledVector(node.velocity, dt);
            node.position.set(
              wrap(node.position.x, BOX.x),
              wrap(node.position.y, BOX.y),
              wrap(node.position.z, BOX.z),
            );
          }
          scale.setScalar(node.radius);
          matrix.compose(node.position, quaternion, scale);
          nodeMesh.setMatrixAt(i, matrix);
        });
        nodeMesh.instanceMatrix.needsUpdate = true;
      };
      updateNodes(0);
      web.add(nodeMesh);

      const glowCanvas = document.createElement('canvas');
      glowCanvas.width = 64;
      glowCanvas.height = 64;
      const glowContext = glowCanvas.getContext('2d')!;
      const gradient = glowContext.createRadialGradient(32, 32, 0, 32, 32, 32);
      gradient.addColorStop(0, 'rgba(255,255,255,0.8)');
      gradient.addColorStop(0.25, 'rgba(255,255,255,0.28)');
      gradient.addColorStop(1, 'rgba(255,255,255,0)');
      glowContext.fillStyle = gradient;
      glowContext.fillRect(0, 0, 64, 64);
      const glowTexture = new THREE.CanvasTexture(glowCanvas);
      const glowPositions = new Float32Array(nodes.length * 3);
      const glowGeometry = new THREE.BufferGeometry();
      const glowPositionAttribute = new THREE.BufferAttribute(glowPositions, 3);
      glowPositionAttribute.setUsage(THREE.DynamicDrawUsage);
      glowGeometry.setAttribute('position', glowPositionAttribute);
      const glowMaterial = new THREE.PointsMaterial({
        color: '#1d1d1f',
        size: 0.43,
        map: glowTexture,
        transparent: true,
        opacity: 0.14,
        depthWrite: false,
        sizeAttenuation: true,
      });
      const glows = new THREE.Points(glowGeometry, glowMaterial);
      glows.frustumCulled = false;
      const updateGlows = () => {
        let count = 0;
        nodes.forEach((node) => {
          if (node.degree < 5) return;
          glowPositions[count * 3] = node.position.x;
          glowPositions[count * 3 + 1] = node.position.y;
          glowPositions[count * 3 + 2] = node.position.z;
          count++;
        });
        glowGeometry.setDrawRange(0, count);
        glowPositionAttribute.needsUpdate = true;
      };
      updateGlows();
      web.add(glows);

      const pulseGeometry = new THREE.SphereGeometry(1, 8, 6);
      const pulseMaterial = new THREE.MeshBasicMaterial({
        color: '#1d1d1f',
        transparent: true,
        opacity: 0.64,
        depthWrite: false,
      });
      const pulseCount = Math.min(11, edges.length);
      const pulseMesh = new THREE.InstancedMesh(pulseGeometry, pulseMaterial, pulseCount);
      pulseMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
      pulseMesh.frustumCulled = false;
      const pulses = Array.from({ length: pulseCount }, (_, i) => {
        const edgeIndex = Math.floor((i / pulseCount) * edges.length);
        return {
          edgeIndex,
          edgeKey: edges[edgeIndex].key,
          t: random(),
          speed: 0.012 + random() * 0.014,
        };
      });
      const pulsePosition = new THREE.Vector3();
      const updatePulses = (dt: number) => {
        pulses.forEach((pulse, i) => {
          if (edges.length === 0) {
            scale.setScalar(0);
          } else {
            pulse.edgeIndex = Math.min(pulse.edgeIndex, edges.length - 1);
            if (edges[pulse.edgeIndex].key !== pulse.edgeKey) {
              const existing = edges.findIndex((edge) => edge.key === pulse.edgeKey);
              if (existing >= 0) {
                pulse.edgeIndex = existing;
              } else {
                pulse.edgeIndex = Math.floor(random() * edges.length);
                pulse.edgeKey = edges[pulse.edgeIndex].key;
                pulse.t = 0;
              }
            }
            if (!reduced) pulse.t += dt * pulse.speed;
            if (pulse.t >= 1) {
              pulse.t %= 1;
              pulse.edgeIndex = Math.floor(random() * edges.length);
              pulse.edgeKey = edges[pulse.edgeIndex].key;
            }
            sampleCurve(edges[pulse.edgeIndex], pulse.t, pulsePosition);
            scale.setScalar(0.025 * Math.sin(Math.PI * pulse.t));
          }
          matrix.compose(pulsePosition, quaternion, scale);
          pulseMesh.setMatrixAt(i, matrix);
        });
        pulseMesh.instanceMatrix.needsUpdate = true;
      };
      updatePulses(0);
      web.add(pulseMesh);
      updateFilaments();

      let targetX = -0.18;
      let targetY = 0.55;
      let currentX = targetX;
      let currentY = targetY;
      let velocityX = 0;
      let velocityY = 0;
      let dragging = false;
      let lastPointerX = 0;
      let lastPointerY = 0;
      let lastInteraction = 0;
      let inView = true;
      let needsRender = true;

      const pointerDown = (event: PointerEvent) => {
        if (event.button !== 0) return;
        dragging = true;
        lastPointerX = event.clientX;
        lastPointerY = event.clientY;
        velocityX = 0;
        velocityY = 0;
        lastInteraction = performance.now();
        canvas.classList.add('is-dragging');
        canvas.setPointerCapture(event.pointerId);
      };
      const pointerMove = (event: PointerEvent) => {
        if (!dragging) return;
        const dx = event.clientX - lastPointerX;
        const dy = event.clientY - lastPointerY;
        lastPointerX = event.clientX;
        lastPointerY = event.clientY;
        targetY += dx * 0.008;
        targetX = THREE.MathUtils.clamp(targetX + dy * 0.008, -1.1, 1.1);
        velocityY = dx * 0.0007;
        velocityX = dy * 0.0007;
        lastInteraction = performance.now();
        needsRender = true;
      };
      const pointerUp = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        lastInteraction = performance.now();
        canvas.classList.remove('is-dragging');
        if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
      };
      canvas.addEventListener('pointerdown', pointerDown, { signal });
      canvas.addEventListener('pointermove', pointerMove, { signal });
      canvas.addEventListener('pointerup', pointerUp, { signal });
      canvas.addEventListener('pointercancel', pointerUp, { signal });

      const resize = () => {
        const rect = shell.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setSize(rect.width, rect.height, false);
        camera.aspect = rect.width / rect.height;
        camera.updateProjectionMatrix();
        needsRender = true;
      };
      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(shell);
      const intersectionObserver = new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          needsRender = true;
        },
        { rootMargin: '100px' },
      );
      intersectionObserver.observe(shell);

      const visibilityChange = () => {
        needsRender = true;
      };
      document.addEventListener('visibilitychange', visibilityChange, { signal });
      const motionChange = (event: MediaQueryListEvent) => {
        reduced = event.matches;
        velocityX = 0;
        velocityY = 0;
        needsRender = true;
      };
      reducedMotion.addEventListener('change', motionChange, { signal });

      // Normal-speed evolution; increase temporarily when testing topology changes.
      const TIME_SCALE = 1;
      let previousTime = performance.now();
      let linkClock = 0;
      let frame = 0;
      let disposed = false;
      const tick = (now: number) => {
        if (disposed) return;
        const dt = Math.min((now - previousTime) / 1000, 0.05);
        const simulationDt = dt * TIME_SCALE;
        previousTime = now;
        if (inView && !document.hidden) {
          if (!dragging) {
            targetY += velocityY;
            targetX = THREE.MathUtils.clamp(targetX + velocityX, -1.1, 1.1);
            velocityX *= 0.9;
            velocityY *= 0.9;
            if (!reduced && now - lastInteraction > 3200) targetY += simulationDt * 0.025;
          }
          const difference =
            Math.abs(targetX - currentX) + Math.abs(targetY - currentY) +
            Math.abs(velocityX) + Math.abs(velocityY);
          currentX += (targetX - currentX) * 0.09;
          currentY += (targetY - currentY) * 0.09;
          web.rotation.set(currentX, currentY, 0.08);
          if (!reduced) {
            linkClock += simulationDt;
            if (linkClock >= LINK_INTERVAL) {
              rebuildEdges();
              linkClock %= LINK_INTERVAL;
            }
            updateNodes(simulationDt);
            updateGlows();
            updatePulses(simulationDt);
            updateFilaments();
          }
          if (!reduced || needsRender || difference > 0.00005) {
            renderer.render(scene, camera);
            needsRender = false;
          }
        }
        frame = requestAnimationFrame(tick);
      };

      resize();
      web.rotation.set(currentX, currentY, 0.08);
      renderer.render(scene, camera);
      shell.classList.add('is-ready');
      frame = requestAnimationFrame(tick);

      document.addEventListener(
        'astro:before-swap',
        () => {
          disposed = true;
          cancelAnimationFrame(frame);
          abort.abort();
          resizeObserver.disconnect();
          intersectionObserver.disconnect();
          lineGeometry.dispose();
          lineMaterial.dispose();
          nodeGeometry.dispose();
          nodeMaterial.dispose();
          glowGeometry.dispose();
          glowMaterial.dispose();
          glowTexture.dispose();
          pulseGeometry.dispose();
          pulseMaterial.dispose();
          renderer.dispose();
        },
        { once: true, signal },
      );
    } catch (error) {
      console.warn('3D cosmic web unavailable; using the static fallback.', error);
      shell.classList.add('is-fallback');
    }
  }
</script>
