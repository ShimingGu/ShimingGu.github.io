---

<canvas id="starfield" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('starfield') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  interface Star {
    x: number; y: number; r: number; a: number; tw: number; ph: number; vx: number; vy: number;
  }
  interface Shoot {
    x: number; y: number; vx: number; vy: number; born: number; life: number;
  }

  let stars: Star[] = [];
  let shoot: Shoot | null = null;
  let nextShoot = 4000;
  let w = 0;
  let h = 0;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth;
    h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.min(240, Math.round((w * h) / 7000));
    stars = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 1.3 + 0.3,
      a: Math.random() * 0.5 + 0.25,
      tw: Math.random() * 1.5 + 0.4,
      ph: Math.random() * Math.PI * 2,
      vx: (Math.random() - 0.5) * 0.02,
      vy: (Math.random() - 0.5) * 0.02,
    }));
    if (reduced) draw(0);
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#dbe7ff';
    for (const s of stars) {
      ctx.globalAlpha = reduced ? s.a : s.a * (0.65 + 0.35 * Math.sin((t / 1000) * s.tw + s.ph));
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    if (shoot) {
      const age = t - shoot.born;
      const k = age / shoot.life;
      if (k >= 1) {
        shoot = null;
      } else {
        const x = shoot.x + shoot.vx * age;
        const y = shoot.y + shoot.vy * age;
        const tail = 90;
        const grad = ctx.createLinearGradient(x, y, x - shoot.vx * tail, y - shoot.vy * tail);
        const fade = Math.sin(Math.PI * k);
        grad.addColorStop(0, `rgba(220,235,255,${0.8 * fade})`);
        grad.addColorStop(1, 'rgba(220,235,255,0)');
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x - shoot.vx * tail, y - shoot.vy * tail);
        ctx.stroke();
      }
    }
  }

  function loop(t: number) {
    if (!document.hidden) {
      for (const s of stars) {
        s.x = (s.x + s.vx + w) % w;
        s.y = (s.y + s.vy + h) % h;
      }
      if (!shoot && t > nextShoot) {
        const ang = Math.PI * (0.15 + Math.random() * 0.2);
        const speed = 0.35 + Math.random() * 0.25;
        shoot = {
          x: Math.random() * w * 0.8,
          y: Math.random() * h * 0.35,
          vx: Math.cos(ang) * speed,
          vy: Math.sin(ang) * speed,
          born: t,
          life: 900 + Math.random() * 500,
        };
        nextShoot = t + 7000 + Math.random() * 9000;
      }
      draw(t);
    }
    requestAnimationFrame(loop);
  }

  resize();
  addEventListener('resize', resize);
  if (!reduced) requestAnimationFrame(loop);
</script>