---
import { useTranslations } from '../i18n/utils';
import type { Lang, UIKey } from '../i18n/ui';

interface Props {
  status: string;
  lang: Lang;
}

const { status, lang } = Astro.props;
const t = useTranslations(lang);
---

<span class={`badge badge-${status}`}>{t(`status.${status}` as UIKey)}</span>