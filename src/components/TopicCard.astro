---
import type { Topic } from '../data/research';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  topic: Topic;
  lang: Lang;
}

const { topic, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="card">
  <h3>{topic.title[lang]}</h3>
  <p>{topic.summary[lang]}</p>
  {
    topic.technical && (
      <p class="topic-technical">
        <span class="ref-label">{t('research.technical')}</span>
        {topic.technical[lang]}
      </p>
    )
  }
  {
    topic.papers && topic.papers.length > 0 && (
      <div class="topic-refs">
        <span class="ref-label">{t('research.papers')}</span>
        <div class="ref-links">
          {topic.papers.map((r) => (
            <a href={`https://arxiv.org/abs/${r.arxiv}`} target="_blank" rel="noopener">
              {r.label[lang]} ↗
            </a>
          ))}
        </div>
      </div>
    )
  }
  {
    topic.reading && topic.reading.length > 0 && (
      <div class="topic-refs">
        <span class="ref-label">{t('research.reading')}</span>
        <div class="ref-links">
          {topic.reading.map((r) => (
            <a href={`https://arxiv.org/abs/${r.arxiv}`} target="_blank" rel="noopener">
              {r.label[lang]} ↗
            </a>
          ))}
        </div>
      </div>
    )
  }
  <div class="chips" style="margin-top: 1rem;">
    {topic.tags.map((tag) => <span class="chip">{tag}</span>)}
  </div>
</article>