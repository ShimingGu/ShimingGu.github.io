---
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/PubItem.astro';
import CosmicWeb from '../../components/CosmicWeb.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { profile } from '../../data/profile';
import { publications } from '../../data/publications';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const t = useTranslations(lang);
const recent = publications.slice(0, 3);
const researchUrl = getRelativeLocaleUrl(lang, 'research');
const photographyUrl = getRelativeLocaleUrl(lang, 'photography');
const widgetsUrl = getRelativeLocaleUrl(lang, 'widgets');
const hasRole = profile.role[lang] !== '';
const hasAffiliation = profile.affiliation[lang] !== '';
---

<Base title={`${profile.name[lang]} — ${zh ? '个人主页' : 'Personal Website'}`}>
  <section class="container hero">
    <div>
      <p class="kicker">
        {zh ? '宇宙学 · 弱引力透镜 · 科学智能' : 'Cosmology · Weak lensing · AI for science'}
      </p>
      <h1>
        {profile.name.en}<span class="zh-name">{profile.name.zh}</span>
      </h1>
      {
        (hasRole || hasAffiliation) && (
          <p class="role">
            {hasRole && <strong>{profile.role[lang]}</strong>}
            {hasRole && hasAffiliation && ' · '}
            {hasAffiliation && profile.affiliation[lang]}
          </p>
        )
      }
      <div class="hero-actions">
        <a class="btn btn-primary" href={researchUrl}>{t('hero.cta.research')}</a>
        <a class="btn" href={profile.email ? `mailto:${profile.email}` : '#contact'}>
          {t('hero.cta.contact')}
        </a>
      </div>
    </div>
    <CosmicWeb />
  </section>

  <section class="container section" id="about">
    <div class="section-head">
      <p class="kicker">About</p>
      <h2 class="section-title">{t('home.about')}</h2>
    </div>
    <div class="grid grid-2">
      <div>
        {
          profile.bio[lang]
            .split('\n\n')
            .map((para) => (
              <p>
                {para.split(/(\[[^\]]+\]\(https?:\/\/[^)]+\))/g).map((seg) => {
                  const m = seg.match(/^\[([^\]]+)\]\((https?:\/\/[^)]+)\)$/);
                  return m ? (
                    <a href={m[2]} target="_blank" rel="noopener">
                      {m[1]}
                    </a>
                  ) : (
                    seg
                  );
                })}
              </p>
            ))
        }
        <h3 style="font-size: 0.95rem; margin-top: 1.5rem;">{t('home.interests')}</h3>
        <div class="chips">
          {profile.interests.map((i) => <span class="chip">{i[lang]}</span>)}
        </div>
      </div>
      <div class="card" id="contact">
        <dl class="info-list">
          {
            hasRole && (
              <div>
                <dt>{t('home.position')}</dt>
                <dd>{profile.role[lang]}</dd>
              </div>
            )
          }
          {
            hasAffiliation && (
              <div>
                <dt>{t('home.affiliation')}</dt>
                <dd>{profile.affiliation[lang]}</dd>
              </div>
            )
          }
          {
            profile.location[lang] && (
              <div>
                <dt>{t('home.location')}</dt>
                <dd>{profile.location[lang]}</dd>
              </div>
            )
          }
          {
            profile.email && (
              <div>
                <dt>{t('common.email')}</dt>
                <dd>
                  <a href={`mailto:${profile.email}`}>{profile.email}</a>
                </dd>
              </div>
            )
          }
          <div>
            <dt>Links</dt>
            <dd>
              {profile.links.github && (
                <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
              )}
              {profile.links.linkedin && (
                <>
                  {' · '}
                  <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
                </>
              )}
              {profile.links.scholar && (
                <>
                  {' · '}
                  <a href={profile.links.scholar} target="_blank" rel="noopener">Scholar</a>
                </>
              )}
              {profile.links.ads && (
                <>
                  {' · '}
                  <a href={profile.links.ads} target="_blank" rel="noopener">ADS</a>
                </>
              )}
            </dd>
          </div>
          {
            profile.cv && (
              <div>
                <dt>{t('common.cv')}</dt>
                <dd>
                  <a href={profile.cv}>{t('common.cv')} (PDF)</a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head" style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;">
      <div>
        <p class="kicker">Publications</p>
        <h2 class="section-title">{t('home.recent')}</h2>
      </div>
      <a href={researchUrl} class="mono" style="font-size: 0.8rem;">{t('home.viewAll')} →</a>
    </div>
    <div class="pub-list">
      {recent.map((p) => <PubItem pub={p} lang={lang} />)}
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <p class="kicker">Explore</p>
      <h2 class="section-title">{t('home.explore')}</h2>
    </div>
    <div class="tile-grid">
      <div class="tile-wrap tile-wide">
        <a
          class="tile tile-research"
          id="tile-research"
          href={researchUrl}
          style="background-image: linear-gradient(180deg, rgba(0,0,0,.30), rgba(0,0,0,.62)), url('/art/ac-9.jpg')"
        >
          <p class="tile-eyebrow">{t('nav.research')}</p>
          <h3>{t('home.explore.research')}</h3>
          <p class="tile-sub">{t('home.explore.researchDesc')}</p>
          <span class="tile-cta">{t('home.tile.more')} ›</span>
        </a>
        <a
          class="tile-credit"
          id="ac-credit"
          href="https://www.aesthetic-computation.com/9/"
          target="_blank"
          rel="noopener"
          aria-label="Image source: Aesthetic Computation"
          title="Aesthetic Computation"
        >
          <img src="/art/ac-logo.png" alt="ac." />
        </a>
      </div>
      <a class="tile tile-photo" href={photographyUrl}>
        <p class="tile-eyebrow">{t('nav.photography')}</p>
        <h3>{t('home.explore.photography')}</h3>
        <p class="tile-sub">{t('home.explore.photographyDesc')}</p>
        <span class="tile-cta">{t('home.tile.more')} ›</span>
      </a>
      <div class="tile-wrap">
        <a
          class="tile tile-widgets"
          id="tile-widgets"
          href={widgetsUrl}
          style="background-image: linear-gradient(180deg, rgba(0,0,0,.30), rgba(0,0,0,.62)), url('/art/tbo-hs417.png')"
        >
          <p class="tile-eyebrow">{t('nav.widgets')}</p>
          <h3>{t('home.explore.widgets')}</h3>
          <p class="tile-sub">{t('home.explore.widgetsDesc')}</p>
          <span class="tile-cta">{t('home.tile.more')} ›</span>
        </a>
        <a
          class="tile-credit tile-credit-tbo"
          id="tbo-credit"
          href="https://www.threebodyorbits.com/orbit/hristov2026_hs417_1_1_1"
          target="_blank"
          rel="noopener"
          aria-label="Image source: Three Body Orbits"
          title="Three Body Orbits"
        >
          <span class="tbo-mark" aria-hidden="true"></span>
          <span class="tbo-name">Three Body Orbits</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const picks = [
    { img: '/art/ac-9.jpg', url: 'https://www.aesthetic-computation.com/9/' },
    { img: '/art/ac-53.jpg', url: 'https://www.aesthetic-computation.com/53/' },
    { img: '/art/ac-50.jpg', url: 'https://www.aesthetic-computation.com/50/' },
  ];
  const pick = picks[Math.floor(Math.random() * picks.length)];
  const tile = document.getElementById('tile-research');
  if (tile) {
    tile.style.backgroundImage = `linear-gradient(180deg, rgba(0,0,0,.30), rgba(0,0,0,.62)), url('${pick.img}')`;
  }
  const credit = document.getElementById('ac-credit');
  if (credit) {
    credit.href = pick.url;
    credit.title = `Image: Aesthetic Computation ${new URL(pick.url).pathname}`;
  }

  const tboPicks = [
    { img: '/art/tbo-hs417.png', url: 'https://www.threebodyorbits.com/orbit/hristov2026_hs417_1_1_1' },
    { img: '/art/tbo-hs667.png', url: 'https://www.threebodyorbits.com/orbit/hristov2026_hs667_1_1_1' },
    { img: '/art/tbo-freefall.png', url: 'https://www.threebodyorbits.com/orbit/freefall_part1_f310_80_6' },
    { img: '/art/tbo-ibic.png', url: 'https://www.threebodyorbits.com/orbit/ib_ic_equalmass_i_b_75_i_c_' },
    { img: '/art/tbo-rosette.png', url: 'https://www.threebodyorbits.com/orbit/rosette2026_a_r9of14_d025000' },
  ];
  const tboPick = tboPicks[Math.floor(Math.random() * tboPicks.length)];
  const wTile = document.getElementById('tile-widgets');
  if (wTile) {
    wTile.style.backgroundImage = `linear-gradient(180deg, rgba(0,0,0,.30), rgba(0,0,0,.62)), url('${tboPick.img}')`;
  }
  const tboCredit = document.getElementById('tbo-credit');
  if (tboCredit) {
    tboCredit.href = tboPick.url;
    tboCredit.title = `Orbit: Three Body Orbits ${new URL(tboPick.url).pathname}`;
  }
</script>