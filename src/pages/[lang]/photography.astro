---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { profile } from '../../data/profile';
import { photos } from '../../data/photos';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base title={`${t('photo.title')} · ${profile.name[lang]}`}>
  <section class="container section">
    <div class="section-head">
      <p class="kicker">{t('photo.kicker')}</p>
      <h1 class="section-title" style="font-size: clamp(2rem, 5vw, 2.8rem);">
        {t('photo.title')}
      </h1>
    </div>
    {
      photos.length > 0 ? (
        <Gallery photos={photos} lang={lang} />
      ) : (
        <div class="card dashed-card empty-state">
          <p>{t('photo.empty')}</p>
          <p class="hint">
            <code>{t('photo.hint')}</code>
          </p>
        </div>
      )
    }
  </section>
</Base>