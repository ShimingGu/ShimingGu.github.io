---
import Base from '../../layouts/Base.astro';
import TopicCard from '../../components/TopicCard.astro';
import PubItem from '../../components/PubItem.astro';
import { profile } from '../../data/profile';
import { topics } from '../../data/research';
import { publications } from '../../data/publications';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base title={`${t('research.title')} · ${profile.name[lang]}`}>
  <section class="container section">
    <div class="section-head">
      <p class="kicker">{t('research.kicker')}</p>
      <h1 class="section-title" style="font-size: clamp(2rem, 5vw, 2.8rem);">
        {t('research.title')}
      </h1>
    </div>

    <h2 style="font-size: 1.2rem; margin-bottom: 1.25rem;">{t('research.topics')}</h2>
    <div class="grid grid-2">
      {topics.map((topic) => <TopicCard topic={topic} lang={lang} />)}
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <p class="kicker">Publications</p>
      <h2 class="section-title">{t('research.pubs')}</h2>
    </div>
    <div class="pub-list">
      {publications.map((p) => <PubItem pub={p} lang={lang} />)}
    </div>
  </section>
</Base>