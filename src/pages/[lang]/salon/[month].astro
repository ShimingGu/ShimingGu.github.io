---
import { createHash } from 'node:crypto';
import SalonBase from '../../../layouts/SalonBase.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, otherLang } from '../../../i18n/utils';
import { salonUi } from '../../../i18n/salon';
import { salon, SALON_YEARS, SALON_RULES, organizerEmail, SALON_API } from '../../../data/salon';
import { secondFriday, monthKey, totalMinutes } from '../../../lib/salon';
import type { Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  const paths = [];
  for (const lang of ['en', 'zh']) {
    for (const year of SALON_YEARS) {
      for (let m = 1; m <= 12; m++) {
        paths.push({ params: { lang, month: monthKey(year, m) } });
      }
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const month = Astro.params.month as string;
const t = salonUi[lang];
const [yearStr, monthStr] = month.split('-');
const date = secondFriday(Number(yearStr), Number(monthStr));
const entries = salon[month] ?? [];
const total = totalMinutes(entries);
const isPast = date < new Date();

// 仓库快照仅作离线回退；直播数据来自 Worker。identifier 哈希不出服务端。
const snapshot = entries.map((e) => ({
  who: e.who,
  minutes: e.minutes,
  talk: e.talk,
  food: e.food,
}));

const titleFmt = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en', {
  year: 'numeric',
  month: 'long',
});
const dateFmt = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long',
});
const other = otherLang(lang);
---

<SalonBase title={`${titleFmt.format(date)} · ${t.title}`}>
  <section class="salon-hero">
    <a class="salon-backlink" href={getRelativeLocaleUrl(lang, 'salon')}>← {t.backToSalon}</a>
    <p class="kicker">{t.detailKicker}</p>
    <h1>{titleFmt.format(date)}</h1>
    <p class="session-date">{dateFmt.format(date)}</p>

    <div class="budget-row">
      <span>{t.budget}</span>
      <span class="budget-total" id="budget-total">{t.total} {total}/60 {t.minUnit}</span>
    </div>
    <div class="budget-bar">
      <div class="budget-fill" id="budget-fill" style={`width: ${(total / SALON_RULES.totalMax) * 100}%`}></div>
      <div class="budget-mark" style={`left: ${(SALON_RULES.totalMin / SALON_RULES.totalMax) * 100}%`}></div>
    </div>
    <div class="budget-scale">
      <span style="left: 0;">0</span>
      <span style={`left: ${(SALON_RULES.totalMin / SALON_RULES.totalMax) * 100}%`}>
        {SALON_RULES.totalMin}
      </span>
      <span style="right: 0;">{SALON_RULES.totalMax} {t.minUnit}</span>
    </div>
    <p class="live-status" id="live-status"></p>
    <p class="rules">{t.rules}</p>
  </section>

  <section class="salon-section">
    <h2 class="salon-h2">{t.lineup}</h2>
    <div class="lineup" id="lineup">
      {
        entries.length === 0 ? (
          <p style="color: #7d7466;">{t.noEntries}</p>
        ) : (
          entries.map((e) => (
            <article class="lineup-entry">
              <div class="lineup-head">
                <span class="lineup-who">{e.who}</span>
                <span class="lineup-min">
                  {e.minutes} {t.minUnit}
                </span>
              </div>
              <p class="lineup-talk">{e.talk[lang] || e.talk[other]}</p>
              <p class="lineup-food">
                {lang === 'zh' ? '想吃：' : 'Wants: '}
                {e.food[lang] || e.food[other]}
              </p>
            </article>
          ))
        )
      }
    </div>
  </section>

  {
    !isPast && (
      <section class="salon-section">
        <div class="salon-form">
          <div class="form-row">
            <div class="segmented" role="group" id="mode-seg">
              <button type="button" data-mode="new" aria-pressed="true">
                {t.modeNew}
              </button>
              <button type="button" data-mode="edit" aria-pressed="false">
                {t.modeEdit}
              </button>
            </div>
            <div class="segmented" role="group" id="lang-seg" aria-label={t.inputLang} style="margin-left: auto;">
              <button type="button" data-ilang="zh" aria-pressed={lang === 'zh' ? 'true' : 'false'}>
                中文
              </button>
              <button type="button" data-ilang="en" aria-pressed={lang === 'en' ? 'true' : 'false'}>
                EN
              </button>
            </div>
          </div>
          <p class="edit-hint" id="edit-hint" hidden>{t.editHint}</p>
          <div class="field">
            <label for="sf-id">{t.idLabel}</label>
            <input id="sf-id" maxlength="24" autocomplete="off" />
          </div>
          <div class="field">
            <label for="sf-who">{t.whoLabel}</label>
            <input id="sf-who" maxlength="40" autocomplete="off" />
          </div>
          <div class="field">
            <label for="sf-talk">{t.talkLabel}</label>
            <input id="sf-talk" maxlength="2000" autocomplete="off" />
          </div>
          <div class="form-row">
            <div class="field" style="width: 170px; margin: 0;">
              <label for="sf-min">{t.minutesLabel}</label>
              <input id="sf-min" type="number" min="10" max="60" step="5" value="20" />
            </div>
            <span class="will-total" id="sf-will"></span>
          </div>
          <div class="field">
            <label for="sf-food">{t.foodLabel}</label>
            <input id="sf-food" maxlength="2000" autocomplete="off" />
          </div>
          <button type="button" class="btn-salon" id="sf-submit">
            {t.submitNew}
          </button>
          <p class="form-msg" id="sf-msg"></p>
          <div class="export-box" id="sf-export" hidden>
            <textarea id="sf-text" readonly></textarea>
            <div class="export-actions">
              <button type="button" class="btn-salon" id="sf-copy">
                {t.copy}
              </button>
              <a class="btn-salon ghost" id="sf-mail" hidden>
                {t.mail}
              </a>
            </div>
            <p class="export-hint">{t.exportHint}</p>
          </div>
        </div>
      </section>
    )
  }

  <script
    type="application/json"
    id="salon-session-data"
    set:html={JSON.stringify({ month, entries: snapshot, organizerEmail, api: SALON_API }).replace(/</g, '\\u003c')}
  />
</SalonBase>

<script>
  import { checkFields, checkNew, exportText, totalMinutes } from '../../../lib/salon';
  import { salonUi } from '../../../i18n/salon';

  const { month, entries: snapshot, organizerEmail, api } = JSON.parse(
    document.getElementById('salon-session-data')!.textContent!,
  );
  const lang = document.documentElement.lang.startsWith('zh') ? 'zh' : 'en';
  const other = lang === 'zh' ? 'en' : 'zh';
  const t = salonUi[lang];
  const $ = (id) => document.getElementById(id);

  const idIn = $('sf-id');
  const whoIn = $('sf-who');
  const talkIn = $('sf-talk');
  const minIn = $('sf-min');
  const foodIn = $('sf-food');
  const msg = $('sf-msg');
  const exportBox = $('sf-export');
  const textOut = $('sf-text');
  const copyBtn = $('sf-copy');
  const mailLink = $('sf-mail');
  const submitBtn = $('sf-submit');
  const willEl = $('sf-will');
  const lineupEl = $('lineup');
  const statusEl = $('live-status');

  let entries = snapshot;
  let live = false;
  let mode = 'new';
  let ilang = lang;

  function say(key, ok) {
    msg.textContent = key ? t[key] : '';
    msg.className = 'form-msg ' + (ok ? 'ok' : 'error');
  }

  function renderLineup() {
    lineupEl.replaceChildren();
    if (entries.length === 0) {
      const p = document.createElement('p');
      p.style.color = '#7d7466';
      p.textContent = t.noEntries;
      lineupEl.append(p);
      return;
    }
    for (const e of entries) {
      const art = document.createElement('article');
      art.className = 'lineup-entry';
      const head = document.createElement('div');
      head.className = 'lineup-head';
      const who = document.createElement('span');
      who.className = 'lineup-who';
      who.textContent = e.who;
      const min = document.createElement('span');
      min.className = 'lineup-min';
      min.textContent = `${e.minutes} ${t.minUnit}`;
      head.append(who, min);
      const talk = document.createElement('p');
      talk.className = 'lineup-talk';
      talk.textContent = e.talk[lang] || e.talk[other];
      const food = document.createElement('p');
      food.className = 'lineup-food';
      food.textContent = (lang === 'zh' ? '想吃：' : 'Wants: ') + (e.food[lang] || e.food[other]);
      art.append(head, talk, food);
      lineupEl.append(art);
    }
  }

  function updateBudget() {
    const total = totalMinutes(entries);
    $('budget-total').textContent = `${t.total} ${total}/60 ${t.minUnit}`;
    $('budget-fill').style.width = `${(total / 60) * 100}%`;
  }

  function setStatus() {
    statusEl.textContent = live ? t.live : t.offline;
    statusEl.className = 'live-status ' + (live ? 'is-live' : 'is-offline');
  }

  async function loadLive() {
    statusEl.textContent = t.loading;
    try {
      const r = await fetch(`${api}/salon/${month}`, { signal: AbortSignal.timeout(8000) });
      if (!r.ok) throw new Error('bad status');
      const j = await r.json();
      entries = j.entries;
      live = true;
      renderLineup();
      updateBudget();
    } catch {
      live = false;
    }
    setStatus();
  }

  async function refresh() {
    const r = await fetch(`${api}/salon/${month}`, { signal: AbortSignal.timeout(8000) });
    if (!r.ok) throw new Error('bad status');
    entries = (await r.json()).entries;
    renderLineup();
    updateBudget();
  }

  function updateWill() {
    if (mode !== 'new') {
      willEl.textContent = '';
      return;
    }
    const m = parseInt(minIn.value, 10);
    if (!Number.isInteger(m)) {
      willEl.textContent = '';
      return;
    }
    willEl.textContent = `${t.willTotal} ${totalMinutes(entries) + m}/60 ${t.minUnit}`;
  }

  function offlineExport(entry) {
    const err = checkNew(
      entries.map((e) => ({ ...e, idHash: '' })),
      '__offline_no_dup_check__',
      entry.minutes,
    );
    if (mode === 'new' && err) {
      say(err, false);
      return;
    }
    say(mode === 'new' ? 'okNew' : 'okEdit', true);
    textOut.value = exportText(month, mode, entry);
    exportBox.hidden = false;
    if (organizerEmail) {
      mailLink.hidden = false;
      mailLink.href =
        `mailto:${organizerEmail}` +
        `?subject=${encodeURIComponent(`[SALON ${month}] ${mode === 'new' ? 'signup' : 'change'}: ${entry.who}`)}` +
        `&body=${encodeURIComponent(textOut.value)}`;
    }
  }

  document.querySelectorAll('#mode-seg button').forEach((btn) =>
    btn.addEventListener('click', () => {
      mode = btn.dataset.mode;
      document
        .querySelectorAll('#mode-seg button')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      submitBtn.textContent = mode === 'new' ? t.submitNew : t.submitEdit;
      $('edit-hint').hidden = mode !== 'edit';
      if (mode === 'edit') {
        whoIn.value = '';
        talkIn.value = '';
        foodIn.value = '';
        minIn.value = '';
        whoIn.placeholder = t.editPlaceholder;
        talkIn.placeholder = t.editPlaceholder;
        foodIn.placeholder = t.editPlaceholder;
        minIn.placeholder = t.editPlaceholder;
      } else {
        whoIn.placeholder = '';
        talkIn.placeholder = '';
        foodIn.placeholder = '';
        minIn.placeholder = '';
        minIn.value = '20';
      }
      say(null, false);
      exportBox.hidden = true;
      updateWill();
    }),
  );

  document.querySelectorAll('#lang-seg button').forEach((btn) =>
    btn.addEventListener('click', () => {
      ilang = btn.dataset.ilang;
      document
        .querySelectorAll('#lang-seg button')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    }),
  );

  minIn.addEventListener('input', updateWill);

  submitBtn.addEventListener('click', async () => {
    const id = idIn.value.trim();
    const who = whoIn.value.trim();
    const minutesRaw = minIn.value.trim();
    const minutes = minutesRaw === '' ? undefined : parseInt(minutesRaw, 10);
    const talk = talkIn.value.trim();
    const food = foodIn.value.trim();

    if (!id) {
      say('errIdEmpty', false);
      return;
    }
    if (mode === 'new') {
      const fieldErr = checkFields(id, who, minutes ?? NaN, talk, food);
      if (fieldErr) {
        say(fieldErr, false);
        return;
      }
    } else if (minutes !== undefined && (!Number.isInteger(minutes) || minutes < 10)) {
      say(!Number.isInteger(minutes) ? 'errMinutesInt' : 'errPerMin', false);
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = t.submitting;
    try {
      const payload = { id, lang: ilang };
      if (who) payload.who = who;
      if (minutes !== undefined) payload.minutes = minutes;
      if (talk) payload.talk = talk;
      if (food) payload.food = food;

      if (live) {
        try {
          const r = await fetch(`${api}/salon/${month}`, {
            method: mode === 'new' ? 'POST' : 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: AbortSignal.timeout(60000),
          });
          const j = await r.json();
          if (!r.ok) {
            say(j.error && t[j.error] ? j.error : 'errGeneric', false);
            return;
          }
          if (mode === 'new') entries.push(j.entry);
          else await refresh();
          renderLineup();
          updateBudget();
          exportBox.hidden = true;
          say(mode === 'new' ? 'okLive' : 'okEditLive', true);
          return;
        } catch {
          // network dropped mid-submit: fall back to export flow
        }
      }

      const entry = {
        id,
        who: who || '(edit)',
        minutes: minutes ?? 20,
        talk: { zh: ilang === 'zh' ? talk : '', en: ilang === 'en' ? talk : '' },
        food: { zh: ilang === 'zh' ? food : '', en: ilang === 'en' ? food : '' },
      };
      offlineExport(entry);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = mode === 'new' ? t.submitNew : t.submitEdit;
    }
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(textOut.value);
    } catch {
      textOut.select();
      document.execCommand('copy');
    }
    const original = t.copy;
    copyBtn.textContent = t.copied;
    setTimeout(() => (copyBtn.textContent = original), 1500);
  });

  renderLineup();
  updateBudget();
  updateWill();
  loadLive();
</script>